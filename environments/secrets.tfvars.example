# Kopiere diese Datei nach environments/<env>.secrets.tfvars.
# Diese Dateien sind per .gitignore vom Repository ausgeschlossen.
#
# Sensible Werte hier ablegen und im Aufruf nicht auf der Kommandozeile übergeben.
# scripts/tf hängt die Datei automatisch an, sobald sie existiert:
#
#   environments/dev.secrets.tfvars
#   environments/prod.secrets.tfvars
#
# example_api_token = "replace-me"
