# Copy this file to environments/<env>.secrets.tfvars.
# These files are excluded from the repository by .gitignore.
#
# Keep sensitive values here instead of passing them on the command line.
# scripts/tf adds the file automatically as soon as it exists:
#
#   environments/dev.secrets.tfvars
#   environments/prod.secrets.tfvars
#
# example_api_token = "replace-me"
