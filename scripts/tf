#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Tool from pipeline.json. For a single run: EXECUTABLE=tofu scripts/tf plan
if [[ -z "${EXECUTABLE:-}" ]]; then
  EXECUTABLE="$(bash "$ROOT/scripts/pipeline.sh" tool)"
fi
case "$EXECUTABLE" in
  terraform | tofu) ;;
  *)
    echo "EXECUTABLE must be terraform or tofu, not '$EXECUTABLE'." >&2
    exit 1
    ;;
esac

usage() {
  cat <<EOF
Usage: scripts/tf [-e ENV | --env ENV] <init|plan|apply|import> [args...]

Without -e/--env, the environment comes from the current Git branch
and pipeline.json. Tool: ${EXECUTABLE}.
For a single run: EXECUTABLE=tofu scripts/tf plan

-e and --env are equivalent and go before the subcommand.

Examples:
  scripts/tf init
  scripts/tf plan
  scripts/tf -e dev plan
  scripts/tf --env prod apply
  scripts/tf --env preview-feature123 init
  scripts/tf plan -destroy
  scripts/tf import aws_s3_bucket.example my-bucket

Previews use environments/preview.tfvars and preview.backend.tfvars unless
environments/preview-<name>.tfvars or .backend.tfvars exist.

EOF
  bash "$ROOT/scripts/pipeline.sh" mapping
  exit 2
}

ENV_ARG=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -e | --env)
      [[ $# -ge 2 ]] || usage
      ENV_ARG="$2"
      shift 2
      ;;
    --env=*)
      ENV_ARG="${1#--env=}"
      [[ -n "$ENV_ARG" ]] || usage
      shift
      ;;
    -h | --help)
      usage
      ;;
    *)
      break
      ;;
  esac
done

[[ $# -ge 1 ]] || usage
CMD="$1"
shift

if ! branch="$(git symbolic-ref --short HEAD 2>/dev/null)"; then
  branch="HEAD"
fi
BRANCH_WS=""
if [[ "$branch" != "HEAD" ]]; then
  if BRANCH_WS="$(bash "$ROOT/scripts/pipeline.sh" workspace "$branch" 2>/dev/null)"; then
    :
  else
    BRANCH_WS=""
  fi
fi

if [[ -n "$ENV_ARG" ]]; then
  WS="$ENV_ARG"
  bash "$ROOT/scripts/pipeline.sh" validate "$WS"
  if [[ -n "$BRANCH_WS" && "$BRANCH_WS" != "$WS" ]]; then
    echo "Note: environment '$WS' differs from branch '$branch' ($BRANCH_WS)." >&2
  fi
else
  WS="$(bash "$ROOT/scripts/pipeline.sh" workspace "$branch")"
  bash "$ROOT/scripts/pipeline.sh" validate "$WS"
fi

ENV_DIR="$ROOT/environments"
TFVARS="$ROOT/$(bash "$ROOT/scripts/pipeline.sh" env-file "$WS" tfvars)"
BACKEND="$ROOT/$(bash "$ROOT/scripts/pipeline.sh" env-file "$WS" backend)"
SECRETS="$ROOT/$(bash "$ROOT/scripts/pipeline.sh" env-file "$WS" secrets)"
PLAN="$ENV_DIR/${WS}.tfplan"

var_args=(-var-file="$TFVARS")
if [[ -f "$SECRETS" ]]; then
  var_args+=(-var-file="$SECRETS")
fi

require_file() {
  local path="$1"
  if [[ ! -f "$path" ]]; then
    echo "Missing: $path" >&2
    exit 1
  fi
}

require_executable() {
  if ! command -v "$EXECUTABLE" >/dev/null 2>&1; then
    echo "Program '$EXECUTABLE' was not found." >&2
    exit 1
  fi
}

ensure_workspace() {
  local current
  unset TF_WORKSPACE
  require_executable
  current="$("$EXECUTABLE" workspace show)"
  if [[ "$current" != "$WS" ]]; then
    echo "Active workspace is '$current', expected '$WS'." >&2
    echo "Run first: scripts/tf init" >&2
    exit 1
  fi
  export TF_WORKSPACE="$WS"
}

case "$CMD" in
  init)
    require_file "$BACKEND"
    unset TF_WORKSPACE
    require_executable
    "$EXECUTABLE" init -reconfigure -input=false -backend-config="$BACKEND"
    if "$EXECUTABLE" workspace list | sed 's/^[* ] //' | grep -qx "$WS"; then
      "$EXECUTABLE" workspace select "$WS"
    else
      "$EXECUTABLE" workspace new "$WS"
    fi
    ;;
  plan)
    require_file "$TFVARS"
    ensure_workspace
    "$EXECUTABLE" plan -input=false "${var_args[@]}" -out="$PLAN" "$@"
    ;;
  apply)
    if [[ $# -gt 0 ]]; then
      echo "apply takes no further arguments and only applies $PLAN." >&2
      exit 1
    fi
    ensure_workspace
    if [[ ! -f "$PLAN" ]]; then
      echo "No plan at $PLAN. Run first: scripts/tf plan" >&2
      exit 1
    fi
    "$EXECUTABLE" apply -input=false "$PLAN"
    rm -f "$PLAN"
    ;;
  import)
    require_file "$TFVARS"
    ensure_workspace
    "$EXECUTABLE" import -input=false "${var_args[@]}" "$@"
    ;;
  *)
    usage
    ;;
esac
