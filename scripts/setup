#!/usr/bin/env bash
# Fragt Tool, Umgebungen und Preview ab und schreibt pipeline.json.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
PIPELINE="$ROOT/scripts/pipeline.sh"
RENDER_ONLY=0

if [[ "${1:-}" == "--render" ]]; then
  RENDER_ONLY=1
elif [[ $# -gt 0 ]]; then
  echo "Aufruf: scripts/setup [--render]" >&2
  exit 2
fi

if [[ ! -r /dev/tty && "$RENDER_ONLY" -eq 0 ]]; then
  echo "scripts/setup braucht ein Terminal. Zum neu Schreiben der Workflows: scripts/setup --render" >&2
  exit 1
fi

bash "$PIPELINE" tool >/dev/null

prompt() {
  local __var=$1
  local text=$2
  local default=$3
  local answer
  if [[ -n "$default" ]]; then
    read -r -p "$text ($default): " answer </dev/tty
    answer=${answer:-$default}
  elif [[ "$text" == *\? ]]; then
    read -r -p "$text " answer </dev/tty
  else
    read -r -p "$text: " answer </dev/tty
  fi
  printf -v "$__var" '%s' "$answer"
}

ask_protected() {
  local default=$1
  local hint="j/N"
  local answer
  if [[ "$default" == "true" ]]; then
    hint="J/n"
  fi
  while true; do
    read -r -p "Geschützt, mit GitHub-Freigabe [$hint]: " answer </dev/tty
    answer=$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')
    if [[ -z "$answer" ]]; then
      printf '%s' "$default"
      return 0
    fi
    case "$answer" in
      j | ja | y | yes | true)
        printf 'true'
        return 0
        ;;
      n | nein | no | false)
        printf 'false'
        return 0
        ;;
      *)
        echo "Bitte j oder n." >&2
        ;;
    esac
  done
}

section() {
  echo
  printf '%s\n\n' "$1"
}

ask_yes() {
  local text=$1
  local default=$2
  local hint="j/N"
  local answer
  if [[ "$default" == "true" ]]; then
    hint="J/n"
  fi
  while true; do
    read -r -p "$text [$hint]: " answer </dev/tty
    answer=$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')
    if [[ -z "$answer" ]]; then
      [[ "$default" == "true" ]]
      return
    fi
    case "$answer" in
      j | ja | y | yes)
        return 0
        ;;
      n | nein | no)
        return 1
        ;;
      *)
        echo "Bitte j oder n." >&2
        ;;
    esac
  done
}

ask_number() {
  local default=$1
  local max=$2
  local answer
  while true; do
    read -r -p "Auswahl [$default]: " answer </dev/tty
    answer=${answer:-$default}
    if [[ "$answer" =~ ^[0-9]+$ ]] && [[ "$answer" -ge 1 ]] && [[ "$answer" -le "$max" ]]; then
      printf '%s' "$answer"
      return 0
    fi
    echo "Bitte eine Zahl von 1 bis $max." >&2
  done
}

stage_ok() {
  local name=$1
  local branch=$2
  local i
  local name_re='^[A-Za-z0-9][A-Za-z0-9_-]*$'
  [[ "$name" =~ $name_re ]] || {
    echo "Stage-Name '$name' ist ungültig." >&2
    return 1
  }
  [[ "$name" != "default" ]] || {
    echo "Stage-Name 'default' ist nicht erlaubt." >&2
    return 1
  }
  [[ "$name" != preview-* ]] || {
    echo "Stage-Name '$name' kollidiert mit Preview-Workspaces." >&2
    return 1
  }
  [[ "$branch" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || {
    echo "Branch '$branch' ist ungültig." >&2
    return 1
  }
  [[ "$branch" != *..* && "$branch" != /* && "$branch" != */ && "$branch" != *//* ]] || {
    echo "Branch '$branch' ist ungültig." >&2
    return 1
  }
  if [[ ${#ENV_NAMES[@]} -eq 0 ]]; then
    return 0
  fi
  for i in "${!ENV_NAMES[@]}"; do
    if [[ "${ENV_NAMES[$i]}" == "$name" ]]; then
      echo "Stage-Name mehrfach: $name" >&2
      return 1
    fi
    if [[ "${ENV_BRANCHES[$i]}" == "$branch" ]]; then
      echo "Branch mehrfach: $branch" >&2
      return 1
    fi
  done
}

ask_stage() {
  local name_default=${1:-}
  local branch_default=${2:-}
  local protected_default=${3:-false}
  local name_prompt="${4:-Welches Environment?}"
  local branch_prompt="${5:-Welcher Branch?}"
  local name branch protected
  while true; do
    prompt name "$name_prompt" "$name_default"
    prompt branch "$branch_prompt" "$branch_default"
    protected=$(ask_protected "$protected_default")
    if stage_ok "$name" "$branch"; then
      ENV_NAMES+=("$name")
      ENV_BRANCHES+=("$branch")
      ENV_PROTECTED+=("$protected")
      return 0
    fi
    name_default=$name
    branch_default=$branch
    protected_default=$protected
  done
}

load_existing() {
  EXISTING_NAMES=()
  EXISTING_BRANCHES=()
  EXISTING_PROTECTED=()
  local name branch protected
  while IFS=$'\t' read -r name branch protected; do
    [[ -n "$name" ]] || continue
    EXISTING_NAMES+=("$name")
    EXISTING_BRANCHES+=("$branch")
    EXISTING_PROTECTED+=("$protected")
  done < <(jq -r '.environments[] | [.name, .branch, (.protected | tostring)] | @tsv' "$ROOT/pipeline.json")
}

pick_production() {
  PROD_NAME=prod
  PROD_BRANCH=main
  PROD_PROTECTED=true
  REST_NAMES=()
  REST_BRANCHES=()
  REST_PROTECTED=()
  local i found=-1
  if [[ ${#EXISTING_NAMES[@]} -eq 0 ]]; then
    return 0
  fi
  for i in "${!EXISTING_NAMES[@]}"; do
    if [[ "${EXISTING_NAMES[$i]}" == "prod" ]]; then
      found=$i
      break
    fi
  done
  if [[ "$found" -lt 0 ]]; then
    for i in "${!EXISTING_NAMES[@]}"; do
      if [[ "${EXISTING_BRANCHES[$i]}" == "main" ]]; then
        found=$i
        break
      fi
    done
  fi
  for i in "${!EXISTING_NAMES[@]}"; do
    if [[ "$found" -ge 0 && "$i" -eq "$found" ]]; then
      PROD_NAME=${EXISTING_NAMES[$i]}
      PROD_BRANCH=${EXISTING_BRANCHES[$i]}
      PROD_PROTECTED=${EXISTING_PROTECTED[$i]}
      continue
    fi
    REST_NAMES+=("${EXISTING_NAMES[$i]}")
    REST_BRANCHES+=("${EXISTING_BRANCHES[$i]}")
    REST_PROTECTED+=("${EXISTING_PROTECTED[$i]}")
  done
}

collect_environments() {
  local i
  ENV_NAMES=()
  ENV_BRANCHES=()
  ENV_PROTECTED=()
  section "Umgebungen"
  ask_stage "$PROD_NAME" "$PROD_BRANCH" "$PROD_PROTECTED" \
    "Wie heißt die Produktiv-Umgebung?" \
    "Welcher Branch bildet sie ab?"
  if [[ ${#REST_NAMES[@]} -gt 0 ]]; then
    for i in "${!REST_NAMES[@]}"; do
      echo
      if ! ask_yes "${REST_NAMES[$i]} auf Branch ${REST_BRANCHES[$i]} übernehmen?" true; then
        break
      fi
      ask_stage "${REST_NAMES[$i]}" "${REST_BRANCHES[$i]}" "${REST_PROTECTED[$i]}" \
        "Welches Environment?" \
        "Welcher Branch?"
    done
  fi
  echo
  while ask_yes "Möchtest du noch ein Environment-Branch-Tracking hinzufügen?" false; do
    ask_stage "" "" false "Welches Environment?" "Welcher Branch?"
    echo
  done
}

ask_preview() {
  local enable_default=false
  local choice default_choice example_branch slug
  section "Preview"
  if [[ "$PREVIEW_MODE" != "off" ]]; then
    enable_default=true
  fi
  if ! ask_yes "Möchtest du Preview-Environments aktivieren?" "$enable_default"; then
    PREVIEW_MODE=off
    return 0
  fi
  echo
  echo "In welchem Format?"
  echo
  echo "  1  Branch-Prefix"
  echo "     Ein Branch wie ${PREVIEW_PREFIX}feature-123 wird zur Umgebung preview-feature-123."
  echo "     Genau eine Ebene nach dem Prefix."
  echo
  example_branch="feature/foo${PREVIEW_SUFFIX}"
  slug=${example_branch%"$PREVIEW_SUFFIX"}
  slug=${slug%/}
  slug=${slug//\//-}
  echo "  2  Branch-Suffix"
  echo "     Ein Branch wie ${example_branch} wird zur Umgebung preview-${slug}."
  echo
  echo "  3  Label am Pull Request"
  echo "     Das Label ${PREVIEW_LABEL} am PR legt die Umgebung aus dem Branch-Namen an."
  echo "     Lokal gibt es kein Label, dafür -e."
  echo
  default_choice=1
  case "$PREVIEW_MODE" in
    suffix) default_choice=2 ;;
    label) default_choice=3 ;;
  esac
  choice=$(ask_number "$default_choice" 3)
  case "$choice" in
    1)
      PREVIEW_MODE=prefix
      prompt PREVIEW_PREFIX "Branch-Prefix, mit abschließendem /" "$PREVIEW_PREFIX"
      ;;
    2)
      PREVIEW_MODE=suffix
      prompt PREVIEW_SUFFIX "Branch-Suffix" "$PREVIEW_SUFFIX"
      ;;
    3)
      PREVIEW_MODE=label
      prompt PREVIEW_LABEL "Label am Pull Request" "$PREVIEW_LABEL"
      ;;
  esac
}

show_summary() {
  local i prot tool_label preview_line
  section "Zusammenfassung"
  echo "So wird pipeline.json geschrieben:"
  echo
  case "$TOOL" in
    tofu) tool_label="OpenTofu" ;;
    *) tool_label="Terraform" ;;
  esac
  echo "  Tool: $tool_label"
  for i in "${!ENV_NAMES[@]}"; do
    prot=""
    if [[ "${ENV_PROTECTED[$i]}" == "true" ]]; then
      prot=" (geschützt)"
    fi
    printf '  %s -> %s%s\n' "${ENV_BRANCHES[$i]}" "${ENV_NAMES[$i]}" "$prot"
  done
  case "$PREVIEW_MODE" in
    off)
      preview_line="aus"
      ;;
    prefix)
      preview_line="Prefix ${PREVIEW_PREFIX}<name> -> preview-<name>"
      ;;
    suffix)
      preview_line="Suffix <branch>${PREVIEW_SUFFIX} -> preview-<slug>"
      ;;
    label)
      preview_line="Label ${PREVIEW_LABEL} am Pull Request"
      ;;
  esac
  echo "  Preview: $preview_line"
  if [[ "$ACTIONS_ENABLED" == "true" ]]; then
    echo "  GitHub Actions: an"
  else
    echo "  GitHub Actions: aus"
  fi
  echo
}

ask_actions() {
  local default=false
  section "GitHub Actions"
  cat <<'EOF'
Die Pipeline in GitHub. Kommentare /tf plan, /tf apply und /tf unlock
laufen dann in Actions. Ist Preview an, läuft die Preview-Umgebung mit.
Die Vorlagen bleiben liegen. Aktivieren legt die .yml-Dateien an,
die GitHub ausführt.

EOF
  if [[ "${ACTIONS_ENABLED:-}" == "true" ]]; then
    default=true
  elif [[ "${ACTIONS_ENABLED:-}" == "false" ]]; then
    default=false
  elif [[ -f .github/workflows/terraform-commands.yml ]]; then
    default=true
  fi
  if ask_yes "Möchtest du GitHub Actions aktivieren?" "$default"; then
    ACTIONS_ENABLED=true
  else
    ACTIONS_ENABLED=false
  fi
}

write_commands_workflow() {
  local src=.github/workflows/terraform-commands.yml.template
  local dest=.github/workflows/terraform-commands.yml
  awk 'BEGIN { drop = 1 } drop && /^#/ { next } { drop = 0; print }' "$src" >"$dest"
  echo "Geschrieben: $dest"
}

remove_workflow() {
  local dest=$1
  if [[ -f "$dest" ]]; then
    rm -f "$dest"
    echo "Entfernt: $dest"
  fi
}

write_config() {
  local dest=$1
  local envs='[]'
  local i
  if [[ ${#ENV_NAMES[@]} -gt 0 ]]; then
    for i in "${!ENV_NAMES[@]}"; do
      envs=$(jq -c \
        --arg name "${ENV_NAMES[$i]}" \
        --arg branch "${ENV_BRANCHES[$i]}" \
        --argjson protected "${ENV_PROTECTED[$i]}" \
        '. + [{name: $name, branch: $branch, protected: $protected}]' <<<"$envs")
    done
  fi
  jq -n \
    --arg tool "$TOOL" \
    --arg mode "$PREVIEW_MODE" \
    --arg prefix "$PREVIEW_PREFIX" \
    --arg suffix "$PREVIEW_SUFFIX" \
    --arg label "$PREVIEW_LABEL" \
    --argjson environments "$envs" \
    '{
      tool: $tool,
      environments: $environments,
      preview: {mode: $mode, prefix: $prefix, suffix: $suffix, label: $label}
    }' >"$dest"
}

preview_job() {
  local ref=$1
  local head_ref=$2
  local pr=${3:-}
  cat <<EOF
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1
          persist-credentials: false
      - uses: ./.github/actions/tf-run
        with:
          command: preview
          ref: ${ref}
          head-ref: ${head_ref}
EOF
  if [[ -n "$pr" ]]; then
    printf '          pr: %s\n' "$pr"
  fi
  cat <<'EOF'
          role-arn: ${{ vars.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION || 'eu-central-1' }}
          executable: ${{ vars.EXECUTABLE }}
          github-token: ${{ github.token }}
          secrets-tfvars: ${{ secrets.TF_SECRETS_TFVARS }}
EOF
}

write_preview_workflow() {
  local dest=$1
  local header=$2
  local mode pattern body
  mode=$(jq -r '.preview.mode' "$ROOT/pipeline.json")
  {
    if [[ -n "$header" ]]; then
      printf '%s\n' "$header"
    fi
    echo "name: Terraform preview"
    echo
    case "$mode" in
      prefix)
        pattern="$(jq -r '.preview.prefix' "$ROOT/pipeline.json")"
        pattern="${pattern%/}/**"
        cat <<EOF
on:
  push:
    branches:
      - "${pattern}"

permissions:
  contents: read

concurrency:
  group: tf-preview-\${{ github.ref }}
  cancel-in-progress: false

jobs:
  apply:
EOF
        preview_job '${{ github.sha }}' '${{ github.ref_name }}'
        ;;
      suffix)
        pattern="$(jq -r '.preview.suffix' "$ROOT/pipeline.json")"
        pattern="**/*${pattern}"
        cat <<EOF
on:
  push:
    branches:
      - "${pattern}"

permissions:
  contents: read

concurrency:
  group: tf-preview-\${{ github.ref }}
  cancel-in-progress: false

jobs:
  apply:
EOF
        preview_job '${{ github.sha }}' '${{ github.ref_name }}'
        ;;
      label)
        local label
        label=$(jq -r '.preview.label' "$ROOT/pipeline.json")
        cat <<EOF
on:
  pull_request:
    types: [labeled, synchronize]

permissions:
  contents: read

concurrency:
  group: tf-preview-\${{ github.event.pull_request.number }}
  cancel-in-progress: false

jobs:
  apply:
    if: >-
      github.event.pull_request.head.repo.full_name == github.repository &&
      (
        (github.event.action == 'labeled' && github.event.label.name == '${label}') ||
        (github.event.action == 'synchronize' && contains(github.event.pull_request.labels.*.name, '${label}'))
      )
EOF
        preview_job '${{ github.event.pull_request.head.sha }}' '${{ github.head_ref }}' '${{ github.event.pull_request.number }}'
        ;;
    esac
  } >"$dest"
}

ensure_env_files() {
  local name region project src backend_src candidate base
  region="eu-central-1"
  project="terraform-aws-template"
  src=""
  for candidate in environments/*.tfvars; do
    [[ -f "$candidate" ]] || continue
    base=$(basename "$candidate")
    [[ "$base" == *.backend.tfvars || "$base" == *.secrets.tfvars ]] && continue
    base=${base%.tfvars}
    [[ "$base" == preview-* ]] && continue
    src=$candidate
    break
  done
  if [[ -n "$src" ]]; then
    region=$(sed -n 's/^aws_region[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$src" | head -n 1)
    project=$(sed -n 's/^project[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$src" | head -n 1)
    region=${region:-eu-central-1}
    project=${project:-terraform-aws-template}
  fi
  backend_src=""
  for candidate in environments/*.backend.tfvars; do
    [[ -f "$candidate" ]] || continue
    backend_src=$candidate
    break
  done
  if [[ -z "$backend_src" && -f environments/preview.backend.tfvars.example ]]; then
    backend_src=environments/preview.backend.tfvars.example
  fi
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    if [[ ! -f "environments/${name}.tfvars" ]]; then
      cat >"environments/${name}.tfvars" <<EOF
aws_region          = "${region}"
project             = "${project}"
example_bucket_name = "REPLACE_ME-${name}-example"
EOF
      echo "Angelegt: environments/${name}.tfvars"
    fi
    if [[ ! -f "environments/${name}.backend.tfvars" ]]; then
      if [[ -z "$backend_src" ]]; then
        echo "Kein Backend-Beispiel für environments/${name}.backend.tfvars." >&2
        exit 1
      fi
      cp "$backend_src" "environments/${name}.backend.tfvars"
      echo "Angelegt: environments/${name}.backend.tfvars"
    fi
  done < <(jq -r '.environments[].name' "$ROOT/pipeline.json")
}

warn_leftovers() {
  local f base known
  known=$(jq -r '.environments[].name' "$ROOT/pipeline.json")
  for f in environments/*.tfvars; do
    [[ -f "$f" ]] || continue
    base=$(basename "$f")
    [[ "$base" == *.backend.tfvars || "$base" == *.secrets.tfvars ]] && continue
    base=${base%.tfvars}
    [[ "$base" == preview-* ]] && continue
    if ! grep -qx "$base" <<<"$known"; then
      echo "Hinweis: $f gehört zu keiner Stage. Die Datei bleibt liegen."
    fi
  done
}

print_manual() {
  local mode prefix suffix label name
  mode=$(jq -r '.preview.mode' "$ROOT/pipeline.json")
  echo
  echo "Noch manuell in GitHub und AWS:"
  echo "GitHub Environments mit Required reviewers:"
  if ! jq -e '.environments[] | select(.protected == true)' "$ROOT/pipeline.json" >/dev/null; then
    echo "  (keine geschützte Stage)"
  else
    jq -r '.environments[] | select(.protected == true) | "  - \(.name)"' "$ROOT/pipeline.json"
  fi
  echo "OIDC-Subjects, ORG/REPO und den Default-Branch ersetzen:"
  echo "  - repo:ORG/REPO:ref:refs/heads/<default-branch>"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    echo "  - repo:ORG/REPO:environment:${name}"
  done < <(jq -r '.environments[] | select(.protected == true) | .name' "$ROOT/pipeline.json")
  case "$mode" in
    prefix)
      prefix=$(jq -r '.preview.prefix' "$ROOT/pipeline.json")
      echo "  - repo:ORG/REPO:ref:refs/heads/${prefix}*"
      ;;
    suffix)
      suffix=$(jq -r '.preview.suffix' "$ROOT/pipeline.json")
      echo "  - repo:ORG/REPO:ref:refs/heads/*${suffix}"
      ;;
    label)
      label=$(jq -r '.preview.label' "$ROOT/pipeline.json")
      echo "  - repo:ORG/REPO:pull_request"
      echo "Label-Modus: das Label '${label}' am Pull Request startet die Preview."
      ;;
    off)
      echo "Preview ist aus. .github/workflows/terraform-preview.yml wird nicht angelegt."
      ;;
  esac
  echo "Das Tool steht in pipeline.json. vars.EXECUTABLE überschreibt es nur, wenn die Variable gesetzt ist."
}

apply_files() {
  local mode header
  ensure_env_files
  warn_leftovers
  mode=$(jq -r '.preview.mode' "$ROOT/pipeline.json")
  if [[ -z "${ACTIONS_ENABLED:-}" ]]; then
    ACTIONS_ENABLED=false
    if [[ -f .github/workflows/terraform-commands.yml ]]; then
      ACTIONS_ENABLED=true
    fi
  fi
  header="# Vorlage. GitHub führt diese Datei nicht aus.
# Im abgeleiteten Repository die Endung .template entfernen.
# scripts/setup schreibt den Auslöser aus pipeline.json neu."
  if [[ "$mode" == "off" ]]; then
    remove_workflow .github/workflows/terraform-preview.yml
  else
    write_preview_workflow .github/workflows/terraform-preview.yml.template "$header"
    echo "Geschrieben: .github/workflows/terraform-preview.yml.template"
    if [[ "$ACTIONS_ENABLED" == "true" ]]; then
      write_preview_workflow .github/workflows/terraform-preview.yml ""
      echo "Geschrieben: .github/workflows/terraform-preview.yml"
    else
      remove_workflow .github/workflows/terraform-preview.yml
    fi
  fi
  if [[ "$ACTIONS_ENABLED" == "true" ]]; then
    write_commands_workflow
    echo "GitHub Actions sind an."
  else
    remove_workflow .github/workflows/terraform-commands.yml
    echo "GitHub Actions sind aus."
  fi
  print_manual
}

if [[ "$RENDER_ONLY" -eq 1 ]]; then
  PIPELINE_CONFIG="$ROOT/pipeline.json" bash "$PIPELINE" check
  apply_files
  exit 0
fi

TOOL=$(jq -r '.tool' "$ROOT/pipeline.json")
PREVIEW_MODE=$(jq -r '.preview.mode' "$ROOT/pipeline.json")
PREVIEW_PREFIX=$(jq -r '.preview.prefix' "$ROOT/pipeline.json")
PREVIEW_SUFFIX=$(jq -r '.preview.suffix' "$ROOT/pipeline.json")
PREVIEW_LABEL=$(jq -r '.preview.label' "$ROOT/pipeline.json")
load_existing
pick_production

section "Einleitung"
cat <<'EOF'
Dieses Setup schreibt pipeline.json im Projektroot.
Daraus lesen lokale Befehle und GitHub Actions, welches Tool läuft,
welche Umgebung zu welchem Branch gehört und ob kurzlebige
Preview-Umgebungen entstehen.

Enter übernimmt den Wert in Klammern.
EOF

section "Tool"
echo "Welches Tool möchtest du nutzen?"
echo
echo "  1  Terraform"
echo "  2  OpenTofu"
echo
tool_default=1
if [[ "$TOOL" == "tofu" ]]; then
  tool_default=2
fi
case "$(ask_number "$tool_default" 2)" in
  1) TOOL=terraform ;;
  2) TOOL=tofu ;;
esac

collect_environments

while true; do
  ask_preview
  ask_actions
  show_summary
  if ! ask_yes "So schreiben?" true; then
    echo "Nichts geschrieben."
    exit 0
  fi
  tmp=$(mktemp)
  write_config "$tmp"
  if PIPELINE_CONFIG="$tmp" bash "$PIPELINE" check; then
    mv "$tmp" "$ROOT/pipeline.json"
    break
  fi
  rm -f "$tmp"
  echo "Die Angaben passen nicht zusammen. Die Preview-Auswahl bitte erneut treffen." >&2
done

echo "Geschrieben: pipeline.json"
apply_files
