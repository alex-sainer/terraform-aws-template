#!/usr/bin/env bash
# Interactive setup for pipeline.json: tool, environments, preview, GitHub Actions.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
PIPELINE="$ROOT/scripts/pipeline.sh"
PROJECT_NAME=$(basename "$ROOT")
RENDER_ONLY=0
STAGE=""
WRITING=0

usage() {
  cat <<EOF
Usage: scripts/setup [--render] [-h | --help]

Configure the pipeline for this repository: Terraform or OpenTofu, the
environment for each long-lived branch, preview environments, and the
GitHub Actions workflows. Writes pipeline.json and the matching files.

Options:
  --render     Re-render workflows and env files from the current
               pipeline.json without asking questions.
  -h, --help   Show this help.

Environment:
  NO_COLOR     Disable colored output.
EOF
}

case "${1:-}" in
  "") ;;
  --render) RENDER_ONLY=1 ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
if [[ $# -gt 1 ]]; then
  usage >&2
  exit 2
fi

# ---------------------------------------------------------------------------
# UI
# ---------------------------------------------------------------------------

HAS_TTY=0
if { : </dev/tty; } 2>/dev/null; then
  HAS_TTY=1
fi
INTERACTIVE=0
if [[ -t 1 && "$HAS_TTY" -eq 1 ]]; then
  INTERACTIVE=1
fi

if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]]; then
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_CYAN=$'\033[36m'
  C_MAGENTA=$'\033[35m'
else
  C_RESET="" C_BOLD="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW="" C_CYAN="" C_MAGENTA=""
fi

# Answered prompt lines since the last ui_mark, for ui_collapse.
UI_LINES=0

cursor_hide() { [[ "$INTERACTIVE" -eq 1 ]] && printf '\033[?25l' || true; }
cursor_show() { [[ "$INTERACTIVE" -eq 1 ]] && printf '\033[?25h' || true; }

clear_lines() {
  local n=$1 k
  [[ "$INTERACTIVE" -eq 1 ]] || return 0
  printf '\r\033[2K'
  for ((k = 0; k < n; k++)); do
    printf '\033[1A\033[2K'
  done
}

ui_mark() { UI_LINES=0; }

ui_collapse() {
  clear_lines "$UI_LINES"
  UI_LINES=0
}

ui_banner() {
  echo
  printf '  %s%s◆ %s%s  %spipeline setup%s\n' "$C_BOLD" "$C_MAGENTA" "$PROJECT_NAME" "$C_RESET" "$C_DIM" "$C_RESET"
  echo
  printf '  Configures environments, preview deployments and GitHub Actions.\n'
  printf '  %sWrites pipeline.json. Enter accepts the default, Ctrl+C aborts.%s\n' "$C_DIM" "$C_RESET"
}

ui_step() {
  echo
  printf '  %s[%s/%s]%s %s%s%s\n' "$C_DIM" "$1" "$2" "$C_RESET" "$C_BOLD" "$3" "$C_RESET"
}

ui_heading() {
  echo
  printf '  %s%s%s\n' "$C_BOLD" "$1" "$C_RESET"
}

ui_hint() { printf '  %s%s%s\n' "$C_DIM" "$1" "$C_RESET"; }
ui_ok() { printf '  %s✔%s %s\n' "$C_GREEN" "$C_RESET" "$1"; }
ui_info() { printf '  %s•%s %s\n' "$C_CYAN" "$C_RESET" "$1"; }
ui_warn() { printf '  %s▲ %s%s\n' "$C_YELLOW" "$1" "$C_RESET"; }
ui_err() { printf '  %s✖ %s%s\n' "$C_RED" "$1" "$C_RESET" >&2; }

die() {
  ui_err "$1"
  exit 1
}

ui_answered() {
  printf '  %s✔%s %s %s›%s %s%s%s\n' "$C_GREEN" "$C_RESET" "$1" "$C_DIM" "$C_RESET" "$C_CYAN" "$2" "$C_RESET"
  UI_LINES=$((UI_LINES + 1))
}

ui_file() {
  local kind=$1 path=$2 note=${3:-}
  local color=$C_GREEN
  case "$kind" in
    "~") color=$C_YELLOW ;;
    "-") color=$C_RED ;;
    "!") color=$C_YELLOW ;;
  esac
  printf '    %s%s%s %s' "$color" "$kind" "$C_RESET" "$path"
  if [[ -n "$note" ]]; then
    printf '  %s%s%s' "$C_DIM" "$note" "$C_RESET"
  fi
  echo
}

read_tty() {
  # read_tty VAR [read options...]; Ctrl+D aborts.
  local __var=$1
  shift
  local __value
  if ! IFS= read -r "$@" __value </dev/tty; then
    echo
    abort
  fi
  printf -v "$__var" '%s' "$__value"
}

# ui_input VAR "Question" "default" [validator]
# The validator gets the answer, prints a reason and returns 1 when invalid.
ui_input() {
  local __var=$1 text=$2 default=${3:-} validator=${4:-}
  local answer err had_err=0 prompt
  prompt="  ${C_CYAN}?${C_RESET} ${C_BOLD}${text}${C_RESET}"
  if [[ -n "$default" ]]; then
    prompt+=" ${C_DIM}(${default})${C_RESET}"
  fi
  prompt+=" "
  while true; do
    if [[ "$INTERACTIVE" -eq 1 ]]; then
      read_tty answer -e -p "$(printf '%s' "$prompt" | sed $'s/\033\\[[0-9;]*m/\001&\002/g')"
    else
      printf '%s' "$prompt"
      read_tty answer
    fi
    answer=$(printf '%s' "$answer" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    answer=${answer:-$default}
    if [[ -n "$validator" ]] && ! err=$("$validator" "$answer"); then
      clear_lines $((1 + had_err))
      printf '    %s✖ %s%s\n' "$C_RED" "$err" "$C_RESET"
      had_err=1
      continue
    fi
    clear_lines $((1 + had_err))
    if [[ "$INTERACTIVE" -eq 1 ]]; then
      ui_answered "$text" "$answer"
    else
      UI_LINES=$((UI_LINES + 1))
    fi
    printf -v "$__var" '%s' "$answer"
    return 0
  done
}

# ui_confirm "Question" default(true|false) ["hint"]
ui_confirm() {
  local text=$1 default=$2 hint=${3:-}
  local keys="y/N" key result
  [[ "$default" == "true" ]] && keys="Y/n"
  printf '  %s?%s %s%s%s' "$C_CYAN" "$C_RESET" "$C_BOLD" "$text" "$C_RESET"
  [[ -n "$hint" ]] && printf ' %s%s%s' "$C_DIM" "$hint" "$C_RESET"
  printf ' %s%s%s ' "$C_DIM" "$keys" "$C_RESET"
  while true; do
    if [[ "$INTERACTIVE" -eq 1 ]]; then
      read_tty key -s -n 1
    else
      read_tty key
    fi
    key=$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')
    case "$key" in
      "") result=$default ;;
      y | yes) result=true ;;
      n | no) result=false ;;
      *) continue ;;
    esac
    break
  done
  if [[ "$INTERACTIVE" -eq 1 ]]; then
    printf '\r\033[2K'
    if [[ "$result" == "true" ]]; then
      ui_answered "$text" "Yes"
    else
      ui_answered "$text" "No"
    fi
  else
    UI_LINES=$((UI_LINES + 1))
  fi
  [[ "$result" == "true" ]]
}

# ui_select "Question" default_index "Label<TAB>hint" ...
# Sets UI_CHOICE to the 0-based index of the chosen option.
UI_CHOICE=0
ui_select() {
  local text=$1 sel=$2
  shift 2
  local n=$# i key rest width=0 label hint
  local labels=() hints=()
  for i in "$@"; do
    label=${i%%$'\t'*}
    hint=""
    [[ "$i" == *$'\t'* ]] && hint=${i#*$'\t'}
    labels+=("$label")
    hints+=("$hint")
    [[ ${#label} -gt $width ]] && width=${#label}
  done

  if [[ "$INTERACTIVE" -ne 1 ]]; then
    printf '  ? %s\n' "$text"
    for ((i = 0; i < n; i++)); do
      printf '    %d) %-*s  %s\n' $((i + 1)) "$width" "${labels[$i]}" "${hints[$i]}"
    done
    while true; do
      printf '  Choice [%d]: ' $((sel + 1))
      read_tty key
      key=${key:-$((sel + 1))}
      if [[ "$key" =~ ^[0-9]+$ ]] && [[ "$key" -ge 1 && "$key" -le "$n" ]]; then
        UI_CHOICE=$((key - 1))
        UI_LINES=$((UI_LINES + n + 2))
        return 0
      fi
    done
  fi

  printf '  %s?%s %s%s%s %s↑/↓ to move, enter to select%s\n' "$C_CYAN" "$C_RESET" "$C_BOLD" "$text" "$C_RESET" "$C_DIM" "$C_RESET"
  cursor_hide
  local first=1
  while true; do
    if [[ "$first" -eq 0 ]]; then
      printf '\033[%dA' "$n"
    fi
    first=0
    for ((i = 0; i < n; i++)); do
      printf '\r\033[2K'
      if [[ "$i" -eq "$sel" ]]; then
        printf '  %s❯ %-*s%s  %s%s%s\n' "$C_CYAN$C_BOLD" "$width" "${labels[$i]}" "$C_RESET" "$C_DIM" "${hints[$i]}" "$C_RESET"
      else
        printf '    %-*s  %s%s%s\n' "$width" "${labels[$i]}" "$C_DIM" "${hints[$i]}" "$C_RESET"
      fi
    done
    read_tty key -s -n 1
    case "$key" in
      $'\033')
        read_tty rest -s -n 2
        case "$rest" in
          "[A" | "OA") sel=$(((sel - 1 + n) % n)) ;;
          "[B" | "OB") sel=$(((sel + 1) % n)) ;;
        esac
        ;;
      k) sel=$(((sel - 1 + n) % n)) ;;
      j) sel=$(((sel + 1) % n)) ;;
      [1-9])
        if [[ "$key" -le "$n" ]]; then
          sel=$((key - 1))
          break
        fi
        ;;
      "") break ;;
    esac
  done
  cursor_show
  clear_lines $((n + 1))
  ui_answered "$text" "${labels[$sel]}"
  UI_CHOICE=$sel
}

cleanup() {
  cursor_show
  if [[ -n "$STAGE" && -d "$STAGE" ]]; then
    rm -rf "$STAGE"
  fi
}

abort() {
  cursor_show
  [[ "$HAS_TTY" -eq 1 ]] && stty sane </dev/tty 2>/dev/null || true
  echo
  if [[ "$WRITING" -eq 1 ]]; then
    ui_err "Interrupted while writing files. Re-run scripts/setup to finish."
  else
    ui_err "Aborted. No files changed."
  fi
  exit 130
}

trap cleanup EXIT
trap abort INT TERM

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------

NAME_RE='^[A-Za-z0-9][A-Za-z0-9_-]*$'
BRANCH_RE='^[A-Za-z0-9][A-Za-z0-9._/-]*$'

ENV_NAMES=()
ENV_BRANCHES=()
ENV_PROTECTED=()

valid_stage_name() {
  local name=$1 i
  if [[ -z "$name" ]]; then
    echo "A name is required."
    return 1
  fi
  if ! [[ "$name" =~ $NAME_RE ]]; then
    echo "Use letters, digits, '-' and '_', starting with a letter or digit."
    return 1
  fi
  if [[ "$name" == "default" ]]; then
    echo "'default' is reserved by Terraform workspaces."
    return 1
  fi
  if [[ "$name" == "preview" || "$name" == preview-* ]]; then
    echo "'preview' and names starting with 'preview-' are reserved for preview environments."
    return 1
  fi
  for ((i = 0; i < ${#ENV_NAMES[@]}; i++)); do
    if [[ "${ENV_NAMES[$i]}" == "$name" ]]; then
      echo "Environment '$name' already exists."
      return 1
    fi
    if [[ "$(secret_suffix "${ENV_NAMES[$i]}")" == "$(secret_suffix "$name")" ]]; then
      echo "'$name' and '${ENV_NAMES[$i]}' would share the secret TF_SECRETS_TFVARS_$(secret_suffix "$name")."
      return 1
    fi
  done
}

secret_suffix() {
  printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_'
}

valid_branch() {
  local branch=$1 i
  if [[ -z "$branch" ]]; then
    echo "A branch is required."
    return 1
  fi
  if ! [[ "$branch" =~ $BRANCH_RE ]] || [[ "$branch" == *..* || "$branch" == */ || "$branch" == *//* ]]; then
    echo "'$branch' is not a valid branch name."
    return 1
  fi
  for ((i = 0; i < ${#ENV_BRANCHES[@]}; i++)); do
    if [[ "${ENV_BRANCHES[$i]}" == "$branch" ]]; then
      echo "Branch '$branch' already deploys to '${ENV_NAMES[$i]}'."
      return 1
    fi
  done
}

valid_prefix() {
  local prefix=${1%/}
  if [[ -z "$prefix" ]]; then
    echo "A prefix is required."
    return 1
  fi
  if [[ "$prefix" == *"*"* || "$prefix" == *'"'* || "$prefix" == *//* ]] || ! [[ "$prefix/" =~ $BRANCH_RE ]]; then
    echo "Use a plain branch path like 'preview', without wildcards."
    return 1
  fi
}

valid_suffix() {
  local suffix=$1
  if [[ -z "$suffix" ]]; then
    echo "A suffix is required."
    return 1
  fi
  if [[ "$suffix" == */* || "$suffix" == *"*"* || "$suffix" == *'"'* ]]; then
    echo "The suffix cannot contain '/', '*' or quotes."
    return 1
  fi
}

valid_label() {
  if ! [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "Use letters, digits, '.', '-' and '_'."
    return 1
  fi
}

# Prints the first stage whose branch matches the current preview rule.
preview_conflict() {
  local i branch
  for ((i = 0; i < ${#ENV_BRANCHES[@]}; i++)); do
    branch=${ENV_BRANCHES[$i]}
    case "$PREVIEW_MODE" in
      prefix) [[ "$branch" == "$PREVIEW_PREFIX"* ]] || continue ;;
      suffix) [[ "$branch" == *"$PREVIEW_SUFFIX" ]] || continue ;;
      *) continue ;;
    esac
    printf "Branch '%s' of environment '%s' matches the preview rule." "$branch" "${ENV_NAMES[$i]}"
    return 0
  done
  return 1
}

# ---------------------------------------------------------------------------
# Questions
# ---------------------------------------------------------------------------

tool_version() {
  local bin=$1 out
  command -v "$bin" >/dev/null 2>&1 || return 1
  out=$(CHECKPOINT_DISABLE=1 "$bin" version 2>/dev/null | head -n 1) || true
  printf '%s' "$out" | sed -n 's/.*v\([0-9][0-9.]*\).*/\1/p'
}

tool_hint() {
  local version
  if version=$(tool_version "$1"); then
    printf '%sinstalled%s%s' "$C_GREEN" "${version:+ ($version)}" "$C_RESET$C_DIM"
  else
    printf 'not found'
  fi
}

ask_tool() {
  local default=0
  [[ "$TOOL" == "tofu" ]] && default=1
  ui_step 1 4 "Tool"
  ui_select "Which IaC tool do you want to use?" "$default" \
    "Terraform"$'\t'"$(tool_hint terraform)" \
    "OpenTofu"$'\t'"$(tool_hint tofu)"
  case "$UI_CHOICE" in
    0) TOOL=terraform ;;
    1) TOOL=tofu ;;
  esac
  if ! command -v "$TOOL" >/dev/null 2>&1; then
    case "$TOOL" in
      terraform) ui_warn "Terraform is not installed. Install it before running scripts/tf: brew install hashicorp/tap/terraform" ;;
      tofu) ui_warn "OpenTofu is not installed. Install it before running scripts/tf: brew install opentofu" ;;
    esac
  fi
}

env_line() {
  local name=$1 branch=$2 protected=$3 tag=""
  [[ "$protected" == "true" ]] && tag="  ${C_YELLOW}protected${C_RESET}"
  printf '%s%s%s %s←%s %s%s' "$C_BOLD" "$name" "$C_RESET" "$C_DIM" "$C_RESET" "$branch" "$tag"
}

add_env() {
  ENV_NAMES+=("$1")
  ENV_BRANCHES+=("$2")
  ENV_PROTECTED+=("$3")
}

# ask_stage name_default branch_default protected_default name_question
ask_stage() {
  local name branch protected=false
  ui_input name "$4" "$1" valid_stage_name
  ui_input branch "Branch that deploys to $name" "$2" valid_branch
  if ui_confirm "Require manual approval before apply?" "$3" "(GitHub environment reviewers)"; then
    protected=true
  fi
  ui_collapse
  add_env "$name" "$branch" "$protected"
  ui_ok "$(env_line "$name" "$branch" "$protected")"
}

load_existing() {
  EXISTING_NAMES=()
  EXISTING_BRANCHES=()
  EXISTING_PROTECTED=()
  local name branch protected
  while IFS=$'\t' read -r name branch protected; do
    [[ -n "$name" ]] || continue
    EXISTING_NAMES+=("$name")
    EXISTING_BRANCHES+=("$branch")
    EXISTING_PROTECTED+=("$protected")
  done < <(jq -r '.environments[] | [.name, .branch, (.protected | tostring)] | @tsv' "$ROOT/pipeline.json")
}

# Production is the stage named prod, else the one on main, else a fresh prod/main.
pick_production() {
  local i found=-1
  PROD_NAME=prod
  PROD_BRANCH=main
  PROD_PROTECTED=true
  REST_NAMES=()
  REST_BRANCHES=()
  REST_PROTECTED=()
  for ((i = 0; i < ${#EXISTING_NAMES[@]}; i++)); do
    if [[ "${EXISTING_NAMES[$i]}" == "prod" ]]; then
      found=$i
      break
    fi
  done
  if [[ "$found" -lt 0 ]]; then
    for ((i = 0; i < ${#EXISTING_NAMES[@]}; i++)); do
      if [[ "${EXISTING_BRANCHES[$i]}" == "main" ]]; then
        found=$i
        break
      fi
    done
  fi
  for ((i = 0; i < ${#EXISTING_NAMES[@]}; i++)); do
    if [[ "$i" -eq "$found" ]]; then
      PROD_NAME=${EXISTING_NAMES[$i]}
      PROD_BRANCH=${EXISTING_BRANCHES[$i]}
      PROD_PROTECTED=${EXISTING_PROTECTED[$i]}
      continue
    fi
    REST_NAMES+=("${EXISTING_NAMES[$i]}")
    REST_BRANCHES+=("${EXISTING_BRANCHES[$i]}")
    REST_PROTECTED+=("${EXISTING_PROTECTED[$i]}")
  done
}

ask_environments() {
  local i name branch protected err
  ui_step 2 4 "Environments"
  ui_hint "Each environment is a long-lived stage that one branch deploys to."
  echo
  ui_mark
  ask_stage "$PROD_NAME" "$PROD_BRANCH" "$PROD_PROTECTED" "Production environment name"

  for ((i = 0; i < ${#REST_NAMES[@]}; i++)); do
    name=${REST_NAMES[$i]}
    branch=${REST_BRANCHES[$i]}
    protected=${REST_PROTECTED[$i]}
    ui_mark
    ui_select "Existing environment $name ← $branch" 0 \
      "Keep"$'\t'"$([[ "$protected" == "true" ]] && echo "protected" || echo "no approval")" \
      "Edit"$'\t'"change name, branch or approval" \
      "Remove"$'\t'"drop it from pipeline.json"
    case "$UI_CHOICE" in
      0)
        if err=$(valid_stage_name "$name") && err=$(valid_branch "$branch"); then
          ui_collapse
          add_env "$name" "$branch" "$protected"
          ui_ok "$(env_line "$name" "$branch" "$protected")"
        else
          ui_collapse
          ui_warn "$err Please adjust it."
          ask_stage "$name" "$branch" "$protected" "Environment name"
        fi
        ;;
      1)
        ui_collapse
        ask_stage "$name" "$branch" "$protected" "Environment name"
        ;;
      2)
        ui_collapse
        printf '  %s– %s ← %s removed%s\n' "$C_DIM" "$name" "$branch" "$C_RESET"
        ;;
    esac
  done

  while true; do
    ui_mark
    if ! ui_confirm "Add another environment?" false; then
      ui_collapse
      break
    fi
    ui_collapse
    ask_stage "" "" false "Environment name"
  done
}

ask_preview() {
  local enable=false default=0 err
  ui_step 3 4 "Preview environments"
  ui_hint "Short-lived environments (preview-<name>) for feature branches or pull requests."
  echo
  case "$PREVIEW_MODE" in
    prefix) enable=true default=0 ;;
    suffix) enable=true default=1 ;;
    label) enable=true default=2 ;;
  esac
  while true; do
    if ! ui_confirm "Enable preview environments?" "$enable"; then
      PREVIEW_MODE=off
      return 0
    fi
    enable=true
    ui_select "How should previews be triggered?" "$default" \
      "Branch prefix"$'\t'"${PREVIEW_PREFIX}feature-1 → preview-feature-1" \
      "Branch suffix"$'\t'"feature/foo${PREVIEW_SUFFIX} → preview-feature--foo" \
      "Pull request label"$'\t'"label '${PREVIEW_LABEL}' on a PR → preview-<branch>"
    default=$UI_CHOICE
    case "$UI_CHOICE" in
      0)
        PREVIEW_MODE=prefix
        ui_hint "Exactly one level after the prefix: ${PREVIEW_PREFIX}foo works, ${PREVIEW_PREFIX}a/b does not."
        ui_input PREVIEW_PREFIX "Branch prefix" "$PREVIEW_PREFIX" valid_prefix
        PREVIEW_PREFIX="${PREVIEW_PREFIX%/}/"
        ;;
      1)
        PREVIEW_MODE=suffix
        ui_input PREVIEW_SUFFIX "Branch suffix" "$PREVIEW_SUFFIX" valid_suffix
        ;;
      2)
        PREVIEW_MODE=label
        ui_input PREVIEW_LABEL "Pull request label" "$PREVIEW_LABEL" valid_label
        ui_hint "Locally there is no label: use scripts/tf -e preview-<name>."
        ;;
    esac
    if err=$(preview_conflict); then
      ui_err "$err"
      ui_hint "Pick another preview rule or turn previews off, or rename that branch in step 2 on the next run."
      echo
      continue
    fi
    break
  done
}

ask_actions() {
  local default=false
  ui_step 4 4 "GitHub Actions"
  ui_hint "Run plan and apply from PR comments: /tf plan, /tf apply, /tf unlock."
  ui_hint "Closing a pull request releases its lock."
  if [[ "$PREVIEW_MODE" != "off" ]]; then
    ui_hint "Preview environments deploy automatically and are destroyed when their pull request closes."
  fi
  ui_hint "Writes .github/workflows/*.yml. The .template files stay untouched."
  echo
  if [[ "${ACTIONS_ENABLED:-}" == "true" ]]; then
    default=true
  elif [[ -z "${ACTIONS_ENABLED:-}" && -f .github/workflows/terraform-commands.yml ]]; then
    default=true
  fi
  if ui_confirm "Enable GitHub Actions workflows?" "$default"; then
    ACTIONS_ENABLED=true
  else
    ACTIONS_ENABLED=false
  fi
}

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

write_config() {
  local dest=$1 envs='[]' i
  for ((i = 0; i < ${#ENV_NAMES[@]}; i++)); do
    envs=$(jq -c \
      --arg name "${ENV_NAMES[$i]}" \
      --arg branch "${ENV_BRANCHES[$i]}" \
      --argjson protected "${ENV_PROTECTED[$i]}" \
      '. + [{name: $name, branch: $branch, protected: $protected}]' <<<"$envs")
  done
  jq -n \
    --arg tool "$TOOL" \
    --arg mode "$PREVIEW_MODE" \
    --arg prefix "$PREVIEW_PREFIX" \
    --arg suffix "$PREVIEW_SUFFIX" \
    --arg label "$PREVIEW_LABEL" \
    --argjson environments "$envs" \
    '{
      tool: $tool,
      environments: $environments,
      preview: {mode: $mode, prefix: $prefix, suffix: $suffix, label: $label}
    }' >"$dest"
}

cfg() { jq -r "$1" "$CFG"; }

# Copies a workflow template without its leading comment block.
render_static_workflow() {
  awk 'BEGIN { drop = 1 } drop && /^#/ { next } { drop = 0; print }' "$1" >"$2"
}

CHECKOUT_ACTION="actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0"

preview_job() {
  local ref=$1
  local head_ref=$2
  local pr=${3:-}
  cat <<EOF
    runs-on: ubuntu-latest
    environment: preview
    permissions:
      contents: read
      id-token: write
EOF
  if [[ -n "$pr" ]]; then
    cat <<EOF
      issues: write
      pull-requests: write
EOF
  fi
  cat <<EOF
    steps:
      - uses: ${CHECKOUT_ACTION}
        with:
          fetch-depth: 1
          persist-credentials: false
      - uses: ./.github/actions/tf-run
        with:
          command: preview
          ref: ${ref}
          head-ref: ${head_ref}
EOF
  if [[ -n "$pr" ]]; then
    printf '          pr: %s\n' "$pr"
  fi
  cat <<'EOF'
          role-arn: ${{ vars.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION || 'eu-central-1' }}
          executable: ${{ vars.EXECUTABLE }}
          github-token: ${{ github.token }}
          secrets-tfvars: ${{ secrets.TF_SECRETS_TFVARS_PREVIEW }}
EOF
}

render_preview_workflow() {
  local dest=$1
  local header=$2
  local mode pattern label
  mode=$(cfg '.preview.mode')
  {
    if [[ -n "$header" ]]; then
      printf '%s\n' "$header"
    fi
    echo "name: Terraform preview"
    echo
    case "$mode" in
      prefix | suffix)
        if [[ "$mode" == "prefix" ]]; then
          pattern="$(cfg '.preview.prefix')"
          pattern="${pattern%/}/**"
        else
          pattern="**/*$(cfg '.preview.suffix')"
        fi
        cat <<EOF
on:
  push:
    branches:
      - "${pattern}"

permissions:
  contents: read

concurrency:
  group: tf-preview-\${{ github.ref }}
  cancel-in-progress: false

jobs:
  apply:
EOF
        preview_job '${{ github.sha }}' '${{ github.ref_name }}'
        ;;
      label)
        label=$(cfg '.preview.label')
        cat <<EOF
on:
  pull_request:
    types: [labeled, synchronize]

permissions:
  contents: read

concurrency:
  group: tf-preview-\${{ github.event.pull_request.number }}
  cancel-in-progress: false

jobs:
  apply:
    if: >-
      github.event.pull_request.head.repo.full_name == github.repository &&
      (
        (github.event.action == 'labeled' && github.event.label.name == '${label}') ||
        (github.event.action == 'synchronize' && contains(github.event.pull_request.labels.*.name, '${label}'))
      )
EOF
        preview_job '${{ github.event.pull_request.head.sha }}' '${{ github.head_ref }}' '${{ github.event.pull_request.number }}'
        ;;
    esac
  } >"$dest"
}

TEMPLATE_HEADER="# Template. GitHub does not run this file.
# In a derived repository, drop the .template extension.
# scripts/setup rewrites the trigger from pipeline.json."

# Records a staged file as created (+) or updated (~), or skips it when unchanged.
stage_op() {
  local path=$1
  if [[ -f "$path" ]]; then
    cmp -s "$STAGE/$path" "$path" && return 0
    OPS+=("~ $path")
  else
    OPS+=("+ $path")
  fi
}

remove_op() {
  [[ -f "$1" ]] && OPS+=("- $1") || true
}

tfvars_value() {
  sed -n "s/^$2[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$1" | head -n 1
}

stage_env_files() {
  local name region project prefix src backend_src candidate base names
  region="eu-central-1"
  project="$PROJECT_NAME"
  prefix="REPLACE_ME"
  src=""
  for candidate in environments/*.tfvars; do
    [[ -f "$candidate" ]] || continue
    base=$(basename "$candidate")
    [[ "$base" == *.backend.tfvars || "$base" == *.secrets.tfvars ]] && continue
    src=$candidate
    break
  done
  if [[ -n "$src" ]]; then
    region=$(tfvars_value "$src" aws_region)
    project=$(tfvars_value "$src" project)
    prefix=$(tfvars_value "$src" name_prefix)
    region=${region:-eu-central-1}
    project=${project:-$PROJECT_NAME}
    prefix=${prefix:-REPLACE_ME}
  fi
  backend_src=""
  for candidate in environments/*.backend.tfvars; do
    [[ -f "$candidate" ]] || continue
    backend_src=$candidate
    break
  done
  BACKEND_SRC=$backend_src
  names=$(cfg '.environments[].name')
  if [[ "$(cfg '.preview.mode')" != "off" ]]; then
    names+=$'\npreview'
  fi
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    if [[ ! -f "environments/${name}.tfvars" ]]; then
      cat >"$STAGE/environments/${name}.tfvars" <<EOF
aws_region  = "${region}"
project     = "${project}"
name_prefix = "${prefix}"
EOF
      OPS+=("+ environments/${name}.tfvars")
    fi
    if [[ ! -f "environments/${name}.backend.tfvars" ]]; then
      if [[ -n "$backend_src" ]]; then
        cp "$backend_src" "$STAGE/environments/${name}.backend.tfvars"
      else
        cat >"$STAGE/environments/${name}.backend.tfvars" <<EOF
bucket = "REPLACE_ME-tfstate"
key    = "${project}/terraform.tfstate"
region = "${region}"
EOF
      fi
      OPS+=("+ environments/${name}.backend.tfvars")
    fi
  done <<<"$names"
}

find_leftovers() {
  local f base known
  LEFTOVERS=()
  known=$(cfg '.environments[].name')
  for f in environments/*.tfvars; do
    [[ -f "$f" ]] || continue
    base=$(basename "$f")
    [[ "$base" == *.backend.tfvars || "$base" == *.secrets.tfvars ]] && continue
    base=${base%.tfvars}
    [[ "$base" == preview || "$base" == preview-* ]] && continue
    grep -qx "$base" <<<"$known" || LEFTOVERS+=("$f")
  done
}

# Renders every derived file into $STAGE and fills OPS with the changes.
plan_files() {
  local mode
  OPS=()
  mkdir -p "$STAGE/environments" "$STAGE/.github/workflows"
  if [[ "$RENDER_ONLY" -eq 0 ]]; then
    cp "$CFG" "$STAGE/pipeline.json"
    if [[ "$(jq -S . pipeline.json)" != "$(jq -S . "$CFG")" ]]; then
      stage_op pipeline.json
    fi
  fi
  stage_env_files
  find_leftovers
  mode=$(cfg '.preview.mode')
  if [[ "$mode" == "off" ]]; then
    remove_op .github/workflows/terraform-preview.yml
  else
    render_preview_workflow "$STAGE/.github/workflows/terraform-preview.yml.template" "$TEMPLATE_HEADER"
    stage_op .github/workflows/terraform-preview.yml.template
    if [[ "$ACTIONS_ENABLED" == "true" ]]; then
      render_preview_workflow "$STAGE/.github/workflows/terraform-preview.yml" ""
      stage_op .github/workflows/terraform-preview.yml
    else
      remove_op .github/workflows/terraform-preview.yml
    fi
  fi
  local wf
  for wf in terraform-commands terraform-cleanup; do
    if [[ "$ACTIONS_ENABLED" == "true" ]]; then
      render_static_workflow ".github/workflows/${wf}.yml.template" "$STAGE/.github/workflows/${wf}.yml"
      stage_op ".github/workflows/${wf}.yml"
    else
      remove_op ".github/workflows/${wf}.yml"
    fi
  done
}

apply_ops() {
  local op kind path i
  WRITING=1
  for ((i = 0; i < ${#OPS[@]}; i++)); do
    op=${OPS[$i]}
    kind=${op%% *}
    path=${op#* }
    case "$kind" in
      "+" | "~")
        mkdir -p "$(dirname "$path")"
        cp "$STAGE/$path" "$path"
        ;;
      "-") rm -f "$path" ;;
    esac
  done
  WRITING=0
}

print_ops() {
  local op i
  for ((i = 0; i < ${#OPS[@]}; i++)); do
    op=${OPS[$i]}
    case "${op%% *}" in
      "+") ui_file "+" "${op#* }" "new" ;;
      "~") ui_file "~" "${op#* }" "update" ;;
      "-") ui_file "-" "${op#* }" "remove" ;;
    esac
  done
  for ((i = 0; i < ${#LEFTOVERS[@]}; i++)); do
    ui_file "!" "${LEFTOVERS[$i]}" "no matching environment, kept as is"
  done
}

tool_label() {
  case "$1" in
    tofu) echo "OpenTofu" ;;
    *) echo "Terraform" ;;
  esac
}

preview_label() {
  case "$PREVIEW_MODE" in
    off) echo "off" ;;
    prefix) echo "branch prefix  ${PREVIEW_PREFIX}<name> → preview-<name>" ;;
    suffix) echo "branch suffix  <branch>${PREVIEW_SUFFIX} → preview-<slug>" ;;
    label) echo "PR label  '${PREVIEW_LABEL}' → preview-<branch>" ;;
  esac
}

show_summary() {
  local i width=0 key="Environments" prot
  ui_heading "Summary"
  printf '    %s%-13s%s %s\n' "$C_DIM" "Tool" "$C_RESET" "$(tool_label "$TOOL")"
  for ((i = 0; i < ${#ENV_BRANCHES[@]}; i++)); do
    [[ ${#ENV_BRANCHES[$i]} -gt $width ]] && width=${#ENV_BRANCHES[$i]}
  done
  for ((i = 0; i < ${#ENV_NAMES[@]}; i++)); do
    prot=""
    [[ "${ENV_PROTECTED[$i]}" == "true" ]] && prot="  ${C_YELLOW}protected${C_RESET}"
    printf '    %s%-13s%s %-*s %s→%s %s%s%s%s\n' "$C_DIM" "$key" "$C_RESET" "$width" "${ENV_BRANCHES[$i]}" \
      "$C_DIM" "$C_RESET" "$C_BOLD" "${ENV_NAMES[$i]}" "$C_RESET" "$prot"
    key=""
  done
  printf '    %s%-13s%s %s\n' "$C_DIM" "Preview" "$C_RESET" "$(preview_label)"
  if [[ "$ACTIONS_ENABLED" == "true" ]]; then
    printf '    %s%-13s%s %senabled%s\n' "$C_DIM" "Actions" "$C_RESET" "$C_GREEN" "$C_RESET"
  else
    printf '    %s%-13s%s disabled\n' "$C_DIM" "Actions" "$C_RESET"
  fi
}

repo_slug() {
  local url
  url=$(git remote get-url origin 2>/dev/null) || return 1
  url=${url%.git}
  url=${url%/}
  printf '%s' "$url" | sed -n 's#.*[:/]\([^/:]*/[^/:]*\)$#\1#p'
}

default_branch() {
  local ref
  ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) || return 1
  printf '%s' "${ref#refs/remotes/origin/}"
}

print_next_steps() {
  local mode slug branch n=0 i op protected created=()
  mode=$(cfg '.preview.mode')
  slug=$(repo_slug) || slug=""
  [[ -n "$slug" ]] || slug="ORG/REPO"
  branch=$(default_branch) || branch=""
  [[ -n "$branch" ]] || branch="<default-branch>"
  protected=$(cfg '[.environments[] | select(.protected == true) | .name] | join(", ")')

  for ((i = 0; i < ${#OPS[@]}; i++)); do
    op=${OPS[$i]}
    [[ "$op" == "+ environments/"* ]] && created+=("${op#* }")
  done

  ui_heading "Next steps"
  local registry=registry.terraform.io
  [[ "$(cfg '.tool')" == "tofu" ]] && registry=registry.opentofu.org
  if [[ -f .terraform.lock.hcl ]] && ! grep -q "provider \"${registry}/" .terraform.lock.hcl; then
    n=$((n + 1))
    printf '    %s%d.%s The provider lock is for the other tool. Refresh and commit it:\n' "$C_BOLD" "$n" "$C_RESET"
    printf '         %srm .terraform.lock.hcl bootstrap/.terraform.lock.hcl%s\n' "$C_CYAN" "$C_RESET"
    printf '         %s%s providers lock -platform=linux_amd64 -platform=darwin_arm64%s  %s(in . and in bootstrap/)%s\n' \
      "$C_CYAN" "$(cfg '.tool')" "$C_RESET" "$C_DIM" "$C_RESET"
  fi
  if [[ ${#created[@]} -gt 0 ]]; then
    n=$((n + 1))
    printf '    %s%d.%s Review the new environment files and replace REPLACE_ME:\n' "$C_BOLD" "$n" "$C_RESET"
    for ((i = 0; i < ${#created[@]}; i++)); do
      if [[ "${created[$i]}" == *.backend.tfvars && -n "$BACKEND_SRC" ]]; then
        printf '         %s  %s(copied from %s)%s\n' "${created[$i]}" "$C_DIM" "$BACKEND_SRC" "$C_RESET"
      else
        printf '         %s\n' "${created[$i]}"
      fi
    done
  fi

  if [[ "$ACTIONS_ENABLED" != "true" ]]; then
    n=$((n + 1))
    printf '    %s%d.%s Run %sscripts/tf init%s, then %sscripts/tf plan%s on an environment branch.\n' \
      "$C_BOLD" "$n" "$C_RESET" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
    ui_hint "  GitHub Actions are off. Run scripts/setup again to enable them."
    return 0
  fi

  if [[ -n "$protected" ]]; then
    n=$((n + 1))
    printf '    %s%d.%s Add required reviewers in GitHub: Settings → Environments → %s%s%s\n' \
      "$C_BOLD" "$n" "$C_RESET" "$C_BOLD" "$protected" "$C_RESET"
    ui_hint "     /tf apply refuses to run on a protected stage until its environment has reviewers."
  fi

  n=$((n + 1))
  printf '    %s%d.%s Plan role (read-only), repository variable %sAWS_ROLE_ARN%s. Trust %s(docs/pipeline.md)%s:\n' \
    "$C_BOLD" "$n" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_DIM" "$C_RESET"
  printf '         %srepo:%s:ref:refs/heads/%s%s\n' "$C_CYAN" "$slug" "$branch" "$C_RESET"
  printf '         %srepo:%s:pull_request%s\n' "$C_CYAN" "$slug" "$C_RESET"

  n=$((n + 1))
  printf '    %s%d.%s One apply role per GitHub environment, environment variable %sAWS_ROLE_ARN%s. Trust:\n' \
    "$C_BOLD" "$n" "$C_RESET" "$C_BOLD" "$C_RESET"
  while IFS= read -r i; do
    [[ -n "$i" ]] || continue
    printf '         %srepo:%s:environment:%s%s\n' "$C_CYAN" "$slug" "$i" "$C_RESET"
  done < <(cfg '.environments[].name')
  if [[ "$mode" != "off" ]]; then
    printf '         %srepo:%s:environment:preview%s  %s(all previews)%s\n' "$C_CYAN" "$slug" "$C_RESET" "$C_DIM" "$C_RESET"
  fi
  ui_hint "     Repositories created after 2026-07-15 use repo:ORG@<owner-id>/REPO@<repo-id>:... in the subject."

  n=$((n + 1))
  printf '    %s%d.%s Optional secrets, one per environment, as repository secrets:\n' "$C_BOLD" "$n" "$C_RESET"
  while IFS= read -r i; do
    [[ -n "$i" ]] || continue
    printf '         %sTF_SECRETS_TFVARS_%s%s\n' "$C_CYAN" "$(secret_suffix "$i")" "$C_RESET"
  done < <(cfg '.environments[].name')
  if [[ "$mode" != "off" ]]; then
    printf '         %sTF_SECRETS_TFVARS_PREVIEW%s\n' "$C_CYAN" "$C_RESET"
  fi

  if [[ "$mode" == "label" ]]; then
    n=$((n + 1))
    printf "    %s%d.%s Add the label '%s' to a pull request to deploy a preview.\n" "$C_BOLD" "$n" "$C_RESET" "$(cfg '.preview.label')"
  fi

  echo
  ui_hint "The tool comes from pipeline.json. vars.EXECUTABLE overrides it only when set."
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

bash "$PIPELINE" tool >/dev/null
STAGE=$(mktemp -d)

if [[ "$RENDER_ONLY" -eq 1 ]]; then
  CFG="$ROOT/pipeline.json"
  PIPELINE_CONFIG="$CFG" bash "$PIPELINE" check
  if [[ -z "${ACTIONS_ENABLED:-}" ]]; then
    ACTIONS_ENABLED=false
    [[ -f .github/workflows/terraform-commands.yml ]] && ACTIONS_ENABLED=true
  fi
  plan_files
  ui_heading "Rendering from pipeline.json"
  print_ops
  if [[ ${#OPS[@]} -eq 0 ]]; then
    ui_ok "Everything is up to date."
  else
    apply_ops
    echo
    ui_ok "Done. ${#OPS[@]} file(s) changed."
  fi
  print_next_steps
  echo
  exit 0
fi

if [[ "$HAS_TTY" -eq 0 ]]; then
  die "scripts/setup needs an interactive terminal. To re-render files without questions: scripts/setup --render"
fi

TOOL=$(jq -r '.tool' "$ROOT/pipeline.json")
PREVIEW_MODE=$(jq -r '.preview.mode' "$ROOT/pipeline.json")
PREVIEW_PREFIX=$(jq -r '.preview.prefix // "preview/"' "$ROOT/pipeline.json")
PREVIEW_SUFFIX=$(jq -r '.preview.suffix // "-preview"' "$ROOT/pipeline.json")
PREVIEW_LABEL=$(jq -r '.preview.label // "preview"' "$ROOT/pipeline.json")
load_existing
pick_production

ui_banner
ask_tool
ask_environments
ask_preview
ask_actions

CFG="$STAGE/pipeline.next.json"
write_config "$CFG"
if ! err=$(PIPELINE_CONFIG="$CFG" bash "$PIPELINE" check 2>&1); then
  die "$err"
fi
plan_files

show_summary
ui_heading "Files"
if [[ ${#OPS[@]} -eq 0 ]]; then
  ui_hint "  No changes. Everything is already up to date."
  print_ops
  echo
  exit 0
fi
print_ops
echo

if ! ui_confirm "Write these changes?" true; then
  ui_hint "Aborted. No files changed."
  echo
  exit 0
fi

apply_ops
echo
ui_ok "Done. ${#OPS[@]} file(s) written."
CFG="$ROOT/pipeline.json"
print_next_steps
echo
