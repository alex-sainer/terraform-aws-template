# Template. GitHub does not run this file.
# In a derived repository, drop the .template extension.
# scripts/setup rewrites the trigger from pipeline.json.
name: Terraform preview

on:
  push:
    branches:
      - "preview/**"

permissions:
  contents: read

concurrency:
  group: tf-preview-${{ github.ref }}
  cancel-in-progress: false

jobs:
  apply:
    runs-on: ubuntu-latest
    environment: preview
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 1
          persist-credentials: false
      - uses: ./.github/actions/tf-run
        with:
          command: preview
          ref: ${{ github.sha }}
          head-ref: ${{ github.ref_name }}
          role-arn: ${{ vars.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION || 'eu-central-1' }}
          executable: ${{ vars.EXECUTABLE }}
          github-token: ${{ github.token }}
          secrets-tfvars: ${{ secrets.TF_SECRETS_TFVARS_PREVIEW }}
