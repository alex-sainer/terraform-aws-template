# Template. GitHub does not run this file.
# In a derived repository, drop the .template extension.
name: Terraform commands

on:
  issue_comment:
    types: [created]

permissions:
  contents: read

jobs:
  gate:
    if: >-
      github.event.issue.pull_request &&
      github.event.comment.user.type != 'Bot' &&
      startsWith(github.event.comment.body, '/tf')
    runs-on: ubuntu-latest
    permissions:
      actions: read
      contents: read
      issues: write
      pull-requests: write
    outputs:
      command: ${{ steps.gate.outputs.command }}
      workspace: ${{ steps.gate.outputs.workspace }}
      environment: ${{ steps.gate.outputs.environment }}
      secret_name: ${{ steps.gate.outputs.secret_name }}
      head_sha: ${{ steps.gate.outputs.head_sha }}
      head_ref: ${{ steps.gate.outputs.head_ref }}
      base_ref: ${{ steps.gate.outputs.base_ref }}
      pr: ${{ steps.gate.outputs.pr }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          persist-credentials: false
      - id: gate
        env:
          COMMENT_BODY: ${{ github.event.comment.body }}
          COMMENT_ID: ${{ github.event.comment.id }}
          COMMENT_USER: ${{ github.event.comment.user.login }}
          COMMENT_USER_TYPE: ${{ github.event.comment.user.type }}
          PR_NUMBER: ${{ github.event.issue.number }}
          GH_TOKEN: ${{ github.token }}
        run: bash .github/actions/tf-run/gate.sh

  plan:
    needs: gate
    if: needs.gate.outputs.command == 'plan'
    runs-on: ubuntu-latest
    concurrency:
      group: tf-pr-${{ needs.gate.outputs.pr }}-plan
      cancel-in-progress: true
    permissions:
      contents: read
      id-token: write
      issues: write
      pull-requests: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          persist-credentials: false
      - uses: ./.github/actions/tf-run
        with:
          command: plan
          ref: ${{ needs.gate.outputs.head_sha }}
          workspace: ${{ needs.gate.outputs.workspace }}
          head-ref: ${{ needs.gate.outputs.head_ref }}
          pr: ${{ needs.gate.outputs.pr }}
          comment-id: ${{ github.event.comment.id }}
          role-arn: ${{ vars.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION || 'eu-central-1' }}
          executable: ${{ vars.EXECUTABLE }}
          github-token: ${{ github.token }}
          # The secret name depends on the workspace, so it is looked up by name.
          secrets-tfvars: ${{ secrets[needs.gate.outputs.secret_name] }} # zizmor: ignore[overprovisioned-secrets]

  apply:
    needs: gate
    if: >-
      needs.gate.outputs.command == 'apply' &&
      needs.gate.outputs.environment != ''
    runs-on: ubuntu-latest
    environment: ${{ needs.gate.outputs.environment }}
    concurrency:
      group: tf-pr-${{ needs.gate.outputs.pr }}-change
      cancel-in-progress: false
    permissions:
      contents: read
      id-token: write
      issues: write
      pull-requests: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          persist-credentials: false
      - uses: ./.github/actions/tf-run
        with:
          command: apply
          ref: ${{ needs.gate.outputs.head_sha }}
          workspace: ${{ needs.gate.outputs.workspace }}
          head-ref: ${{ needs.gate.outputs.head_ref }}
          pr: ${{ needs.gate.outputs.pr }}
          comment-id: ${{ github.event.comment.id }}
          role-arn: ${{ vars.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION || 'eu-central-1' }}
          executable: ${{ vars.EXECUTABLE }}
          github-token: ${{ github.token }}
          # The secret name depends on the workspace, so it is looked up by name.
          secrets-tfvars: ${{ secrets[needs.gate.outputs.secret_name] }} # zizmor: ignore[overprovisioned-secrets]

  unlock:
    needs: gate
    if: needs.gate.outputs.command == 'unlock'
    runs-on: ubuntu-latest
    concurrency:
      group: tf-pr-${{ needs.gate.outputs.pr }}-change
      cancel-in-progress: false
    permissions:
      contents: read
      id-token: write
      issues: write
      pull-requests: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          persist-credentials: false
      - uses: ./.github/actions/tf-run
        with:
          command: unlock
          ref: ${{ needs.gate.outputs.head_sha }}
          workspace: ${{ needs.gate.outputs.workspace }}
          head-ref: ${{ needs.gate.outputs.head_ref }}
          pr: ${{ needs.gate.outputs.pr }}
          comment-id: ${{ github.event.comment.id }}
          role-arn: ${{ vars.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION || 'eu-central-1' }}
          executable: ${{ vars.EXECUTABLE }}
          github-token: ${{ github.token }}
