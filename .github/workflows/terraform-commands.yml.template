# Vorlage. GitHub führt diese Datei nicht aus.
# Im abgeleiteten Repository die Endung .template entfernen.
name: Terraform commands

on:
  issue_comment:
    types: [created]

permissions:
  contents: read

concurrency:
  group: tf-pr-${{ github.event.issue.number }}-${{ startsWith(github.event.comment.body, '/tf plan') && 'plan' || 'keep' }}
  cancel-in-progress: ${{ startsWith(github.event.comment.body, '/tf plan') }}

jobs:
  gate:
    if: >-
      github.event.issue.pull_request &&
      github.event.comment.user.type != 'Bot' &&
      startsWith(github.event.comment.body, '/tf')
    runs-on: ubuntu-latest
    permissions:
      contents: read
      issues: write
      pull-requests: write
    outputs:
      command: ${{ steps.gate.outputs.command }}
      workspace: ${{ steps.gate.outputs.workspace }}
      head_sha: ${{ steps.gate.outputs.head_sha }}
      head_ref: ${{ steps.gate.outputs.head_ref }}
      base_ref: ${{ steps.gate.outputs.base_ref }}
      pr: ${{ steps.gate.outputs.pr }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1
          persist-credentials: false
      - id: gate
        env:
          COMMENT_BODY: ${{ github.event.comment.body }}
          COMMENT_ID: ${{ github.event.comment.id }}
          COMMENT_USER: ${{ github.event.comment.user.login }}
          COMMENT_USER_TYPE: ${{ github.event.comment.user.type }}
          PR_NUMBER: ${{ github.event.issue.number }}
          GH_TOKEN: ${{ github.token }}
        run: bash .github/actions/tf-run/gate.sh

  plan:
    needs: gate
    if: needs.gate.outputs.command == 'plan'
    runs-on: ubuntu-latest
    permissions:
      actions: write
      contents: read
      id-token: write
      issues: write
      pull-requests: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1
          persist-credentials: false
      - uses: ./.github/actions/tf-run
        with:
          command: plan
          ref: ${{ needs.gate.outputs.head_sha }}
          workspace: ${{ needs.gate.outputs.workspace }}
          head-ref: ${{ needs.gate.outputs.head_ref }}
          pr: ${{ needs.gate.outputs.pr }}
          comment-id: ${{ github.event.comment.id }}
          role-arn: ${{ vars.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION || 'eu-central-1' }}
          executable: ${{ vars.EXECUTABLE || 'terraform' }}
          github-token: ${{ github.token }}
          secrets-tfvars: ${{ secrets.TF_SECRETS_TFVARS }}

  apply-protected:
    needs: gate
    if: >-
      needs.gate.outputs.command == 'apply' &&
      (needs.gate.outputs.workspace == 'prod' || needs.gate.outputs.workspace == 'staging')
    runs-on: ubuntu-latest
    environment: ${{ needs.gate.outputs.workspace }}
    permissions:
      actions: read
      contents: read
      id-token: write
      issues: write
      pull-requests: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1
          persist-credentials: false
      - uses: ./.github/actions/tf-run
        with:
          command: apply
          ref: ${{ needs.gate.outputs.head_sha }}
          workspace: ${{ needs.gate.outputs.workspace }}
          head-ref: ${{ needs.gate.outputs.head_ref }}
          pr: ${{ needs.gate.outputs.pr }}
          comment-id: ${{ github.event.comment.id }}
          role-arn: ${{ vars.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION || 'eu-central-1' }}
          executable: ${{ vars.EXECUTABLE || 'terraform' }}
          github-token: ${{ github.token }}
          secrets-tfvars: ${{ secrets.TF_SECRETS_TFVARS }}

  apply-open:
    needs: gate
    if: >-
      needs.gate.outputs.command == 'apply' &&
      needs.gate.outputs.workspace != 'prod' &&
      needs.gate.outputs.workspace != 'staging'
    runs-on: ubuntu-latest
    permissions:
      actions: read
      contents: read
      id-token: write
      issues: write
      pull-requests: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1
          persist-credentials: false
      - uses: ./.github/actions/tf-run
        with:
          command: apply
          ref: ${{ needs.gate.outputs.head_sha }}
          workspace: ${{ needs.gate.outputs.workspace }}
          head-ref: ${{ needs.gate.outputs.head_ref }}
          pr: ${{ needs.gate.outputs.pr }}
          comment-id: ${{ github.event.comment.id }}
          role-arn: ${{ vars.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION || 'eu-central-1' }}
          executable: ${{ vars.EXECUTABLE || 'terraform' }}
          github-token: ${{ github.token }}
          secrets-tfvars: ${{ secrets.TF_SECRETS_TFVARS }}

  unlock:
    needs: gate
    if: needs.gate.outputs.command == 'unlock'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
      issues: write
      pull-requests: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1
          persist-credentials: false
      - uses: ./.github/actions/tf-run
        with:
          command: unlock
          ref: ${{ needs.gate.outputs.head_sha }}
          workspace: ${{ needs.gate.outputs.workspace }}
          head-ref: ${{ needs.gate.outputs.head_ref }}
          pr: ${{ needs.gate.outputs.pr }}
          comment-id: ${{ github.event.comment.id }}
          role-arn: ${{ vars.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION || 'eu-central-1' }}
          executable: ${{ vars.EXECUTABLE || 'terraform' }}
          github-token: ${{ github.token }}
