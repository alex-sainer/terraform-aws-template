root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# shfmt reads this section, including scripts without an extension such as scripts/tf.
[[shell]]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true
